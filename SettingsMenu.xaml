<UserControl
    x:Class="PocketLLM.SettingsMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PocketLLM"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="350"
    d:DesignHeight="350"
    Background="Transparent"
    mc:Ignorable="d">

    <Border
        Background="#FF1E1E1E"
        BorderBrush="Gray"
        BorderThickness="1"
        CornerRadius="5">
        <StackPanel Margin="10" HorizontalAlignment="Center">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontFamily="/Resources/Noto/NotoSans-Bold.ttf#Noto Sans"
                FontSize="24"
                Foreground="White"
                Text="Settings" />
            <Border
                Height="10"
                Margin="10"
                Background="#FF505050"
                CornerRadius="5" />

            <!--  LLM TYPE  -->

            <StackPanel
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Margin="10"
                    VerticalAlignment="Center"
                    FontFamily="/Resources/Noto/NotoSans-Regular.ttf#Noto Sans"
                    FontSize="18"
                    Foreground="White"
                    Text="LLMType:" />
                <TextBox
                    x:Name="LLMTypeTextBox"
                    Width="200"
                    Height="30"
                    Padding="5"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="ChatGPT"
                    materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                    Background="#FF505050"
                    BorderBrush="#FF505050"
                    FontFamily="/Resources/Noto/NotoSans-Bold.ttf#Noto Sans"
                    FontSize="14"
                    Foreground="White"
                    IsEnabled="False"
                    Text="ChatGPT" />
            </StackPanel>

            <!--  API KEY  -->

            <StackPanel
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Margin="10"
                    VerticalAlignment="Center"
                    FontFamily="/Resources/Noto/NotoSans-Regular.ttf#Noto Sans"
                    FontSize="18"
                    Foreground="White"
                    Text="API Key:   " />
                <TextBox
                    x:Name="ApiKeyTextBox"
                    Width="200"
                    Height="30"
                    Padding="5"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="sk- • • • • • • • • • • • •"
                    materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                    Background="#FF505050"
                    BorderBrush="#FF505050"
                    FontFamily="/Resources/Noto/NotoSans-Bold.ttf#Noto Sans"
                    FontSize="14"
                    Foreground="White"
                    Text="{Binding ApiKey, Mode=TwoWay}" />
            </StackPanel>

            <!--  MODEL  -->

            <StackPanel
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Margin="10"
                    VerticalAlignment="Center"
                    FontFamily="/Resources/Noto/NotoSans-Regular.ttf#Noto Sans"
                    FontSize="18"
                    Foreground="White"
                    Text="Model:     " />
                <TextBox
                    x:Name="ModelTextBox"
                    Width="200"
                    Height="30"
                    Padding="5"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="gpt-4o-mini"
                    materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                    Background="#FF505050"
                    BorderBrush="#FF505050"
                    FontFamily="/Resources/Noto/NotoSans-Bold.ttf#Noto Sans"
                    FontSize="14"
                    Foreground="White"
                    Text="{Binding Model, Mode=TwoWay}" />
            </StackPanel>

            <!--  is AutoRun checkbox  -->
            <StackPanel
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Margin="10"
                    VerticalAlignment="Center"
                    FontFamily="/Resources/Noto/NotoSans-Regular.ttf#Noto Sans"
                    FontSize="18"
                    Foreground="White"
                    Text="Will start with system:" />
                <Border
                    Width="30"
                    Height="30"
                    VerticalAlignment="Center"
                    Background="#FF505050"
                    BorderBrush="#FF505050"
                    CornerRadius="5">

                    <CheckBox
                        x:Name="AutoRunCheckBox"
                        Margin="0"
                        VerticalAlignment="Center"
                        IsChecked="{Binding isAutoStart, Mode=TwoWay}" />
                </Border>
            </StackPanel>
            <!--  SAVE BUTTON  -->

            <Button
                x:Name="SaveButton"
                Width="50"
                Height="50"
                Margin="20"
                Padding="0"
                HorizontalAlignment="Center"
                Background="#50464646"
                Click="SaveButton_Click"
                Style="{StaticResource ServiceButton}">
                <materialDesign:PackIcon
                    Width="50"
                    Height="50"
                    Foreground="White"
                    Kind="ContentSave" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
