<Window
    x:Class="PocketLLM.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PocketLLM"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="clr-namespace:PocketLLM.Services"
    Title="PocketLLM"
    Width="400"
    Height="800"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <local:BubbleColorConverter x:Key="BubbleColorConverter" />
        <local:BubbleAlignConverter x:Key="BubbleAlignConverter" />
        <services:MarkdownConverter x:Key="MarkdownConverter" />
    </Window.Resources>

    <Border
        Width="400"
        Height="800"
        Background="Transparent"
        BorderThickness="1"
        ClipToBounds="True"
        CornerRadius="12">

        <Grid x:Name="RootGrid">
            <Border
                x:Name="TopBar"
                Height="18"
                VerticalAlignment="Top"
                Background="#FF505050"
                CornerRadius="12,12,0,0">

                <Grid>
                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Grid>
                            <Button
                                x:Name="SettingsButton"
                                Width="50"
                                Height="50"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="SettingsButton_Click"
                                Style="{StaticResource ServiceButton}">
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    Foreground="White"
                                    Kind="Settings" />
                            </Button>

                            <Popup
                                x:Name="SettingsPopup"
                                AllowsTransparency="True"
                                Placement="Center"
                                PlacementTarget="{Binding ElementName=RootGrid}"
                                StaysOpen="False">
                                <local:SettingsMenu />
                            </Popup>
                        </Grid>

                        <Button
                            x:Name="CloseButton"
                            Width="50"
                            Height="50"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="CloseButton_Click"
                            Style="{StaticResource ServiceButton}">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Foreground="White"
                                Kind="Close" />
                        </Button>

                    </StackPanel>
                </Grid>

            </Border>
            <Grid
                x:Name="ContentGrid"
                Margin="0,18,0,0"
                Background="#FF1E1E1E">

                <ScrollViewer Margin="4,4,4,50" VerticalScrollBarVisibility="Hidden">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar">
                            <Setter Property="Width" Value="4" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Grid Background="Transparent">
                                            <Track Name="PART_Track" IsDirectionReversed="True">
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border
                                                                    Width="4"
                                                                    Background="#878787"
                                                                    CornerRadius="4" />
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ScrollViewer.Resources>
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    MaxWidth="300"
                                    Margin="6"
                                    Padding="10"
                                    HorizontalAlignment="{Binding IsUser, Converter={StaticResource BubbleAlignConverter}}"
                                    Background="{Binding IsUser, Converter={StaticResource BubbleColorConverter}}"
                                    CornerRadius="12">

                                    <FlowDocumentScrollViewer
                                        Background="Transparent"
                                        Document="{Binding Text, Converter={StaticResource MarkdownConverter}}"
                                        FontFamily="Noto Sans"
                                        FontSize="18"
                                        Foreground="White"
                                        TextOptions.TextFormattingMode="Ideal"
                                        TextOptions.TextRenderingMode="ClearType"
                                        VerticalScrollBarVisibility="Hidden" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBox
                    x:Name="InputField"
                    Width="340"
                    Height="40"
                    Margin="10,0,0,10"
                    Padding="5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    materialDesign:HintAssist.Hint="Message..."
                    materialDesign:TextFieldAssist.TextFieldCornerRadius="4"
                    Background="#FF505050"
                    BorderThickness="0"
                    FontFamily="/Resources/Noto/NotoSans-Bold.ttf#Noto Sans"
                    FontSize="20"
                    Foreground="White"
                    KeyDown="EnterClickHandler"
                    TextWrapping="Wrap" />

                <Button
                    x:Name="SendButton"
                    Width="40"
                    Height="40"
                    Margin="0,0,5,10"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    materialDesign:ButtonAssist.CornerRadius="10"
                    Background="#FF505050"
                    BorderThickness="0"
                    Click="SendButton_Click">

                    <materialDesign:PackIcon
                        Width="25"
                        Height="25"
                        Foreground="White"
                        Kind="Send" />
                </Button>
            </Grid>
        </Grid>
    </Border>


</Window>
